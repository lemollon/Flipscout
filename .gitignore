.env

# Bid-sentry local state + Scheduled Task log (per-machine, not code)
flipscout_mybids_state.json
mybids_run.log

# Generated sweep state - seeded per machine, must not be shared or replayed.
# Slipped into the tree on PR #39 via `git add -A`; the mybids/hunt state files
# beside it were already ignored and this one was simply missed.
fb_sweep_seen.json
flipscout_seen.json
.fbprofile/
fb_sweep_run.log
.sgwprofile/
.hibidprofile/
snipe_armed.json
hibid_armed.json
# Which watch-list lots have already been carded. Per-machine, and committing it
# would tell every other checkout those lots were already alerted - i.e. it
# would SILENCE them. Same reason as its siblings above.
hibid_watch_seen.json
watchlist_state.json
hibid_bidform.json
sgw_bidform.json
SNIPE_DISABLED
snipe_run.log

# Local queue for the eBay T-10 last call (ebayclose). Machine state, like
# flipscout_seen.json - it is rebuilt from the published board on first run.
ebay_closing_state.json
